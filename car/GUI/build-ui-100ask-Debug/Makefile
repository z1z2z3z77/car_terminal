	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../../../../100ask_imx6ull-sdk/Buildroot_2020.02.x/output/host/mkspecs/features/data/dummy.cpp $(DISTDIR)/
